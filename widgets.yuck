; == == == This file creates all the basic widgets used by EWW == == ==
; i.e, it basically creates widgets that are used in larger widgets in the eww.yuck file

(include "./variables.yuck")

; == == == Time == == ==
(defwidget time []
    (label :class "time"
           :tooltip "${formattime(EWW_TIME, '%H:%M:%S, %A')}"
           :text {formattime(EWW_TIME, '%H:%M')}
    )
)

(defwidget hour []
    (label :class "hour"
           :text {formattime(EWW_TIME, '%H')}
    )
)

(defwidget minute []
    (label :class "minute"
           :text {formattime(EWW_TIME, '%M')}
    )
)

(defwidget date []
    (label :class "date"
           :tooltip "${formattime(EWW_TIME, '%A, %B %d, %Y')}"
           :text {formattime(EWW_TIME, "%Y-%m-%d")}
    )
)

; == == == Weather == == ==
(defwidget weather_short []
    (label :class "weather-short"
           :tooltip "Temperature / Feels like / wind"
           :text "${weather_temp}°C / ${weather_feels}°C / ${weather_wind}m/s"
    )
)

(defwidget weather_long []
    (box :class "weather-long"
         :orientation "vertical"
         (box :orientation "horizontal"
              (label :text "${weather_temp}°C")
              (label :text "${weather_feels}°C")
              (label :text "${weather_humidity}%")
         )
         (box :orientation "horizontal"
              (label :text {weather_cond_full})
              (label :text "${weather_pressure}Pa")
              (label :text {weather_locale})
          )
         (box :orientation "horizontal"
              (label :text "${weather_wind}m/s")
              (label :text "${weather_deg}°")
              (label :text "(${weather_gust}m/s)")
          )
    )
)


; == == == System == == ==
; CPU
(defwidget CPU_short []
    (box :class "cpu-short"
         :space-evenly false
         :spacing 5
         (image :path "./icons/cpu.svg")
         (label :text "${round(EWW_CPU.avg, 2)}%")
    )
)

; RAM
(defwidget RAM_short []
    (box :class "ram-short"
         :space-evenly false
         :spacing 5
         (image :path "./icons/memory.svg")
         (label :text "${round(EWW_RAM.used_mem_perc, 2)}%")
    )
)

; Battery
(defwidget battery []
    (box :class "battery"
         :space-evenly false
         :spacing 5
         (image :icon {EWW_BATTERY.BAT1.status == "Charging" && EWW_BATTERY.BAT1.capacity <= 10 ? "battery-level-10-charging-symbolic" :
                       EWW_BATTERY.BAT1.status == "Charging" && EWW_BATTERY.BAT1.capacity <= 20 ? "battery-level-20-charging-symbolic" :
                       EWW_BATTERY.BAT1.status == "Charging" && EWW_BATTERY.BAT1.capacity <= 30 ? "battery-level-30-charging-symbolic" :
                       EWW_BATTERY.BAT1.status == "Charging" && EWW_BATTERY.BAT1.capacity <= 40 ? "battery-level-40-charging-symbolic" :
                       EWW_BATTERY.BAT1.status == "Charging" && EWW_BATTERY.BAT1.capacity <= 50 ? "battery-level-50-charging-symbolic" :
                       EWW_BATTERY.BAT1.status == "Charging" && EWW_BATTERY.BAT1.capacity <= 60 ? "battery-level-60-charging-symbolic" :
                       EWW_BATTERY.BAT1.status == "Charging" && EWW_BATTERY.BAT1.capacity <= 70 ? "battery-level-70-charging-symbolic" :
                       EWW_BATTERY.BAT1.status == "Charging" && EWW_BATTERY.BAT1.capacity <= 80 ? "battery-level-80-charging-symbolic" :
                       EWW_BATTERY.BAT1.status == "Charging" && EWW_BATTERY.BAT1.capacity <= 90 ? "battery-level-90-charging-symbolic" : 
                       EWW_BATTERY.BAT1.status == "Full" && EWW_BATTERY.BAT1.capacity <= 100 ? "battery-level-100-charged-symbolic" : 
                       EWW_BATTERY.BAT1.status == "Discharging" && EWW_BATTERY.BAT1.capacity <= 10 ? "battery-level-10-symbolic" : 
                       EWW_BATTERY.BAT1.status == "Discharging" && EWW_BATTERY.BAT1.capacity <= 20 ? "battery-level-20-symbolic" : 
                       EWW_BATTERY.BAT1.status == "Discharging" && EWW_BATTERY.BAT1.capacity <= 30 ? "battery-level-30-symbolic" : 
                       EWW_BATTERY.BAT1.status == "Discharging" && EWW_BATTERY.BAT1.capacity <= 40 ? "battery-level-40-symbolic" : 
                       EWW_BATTERY.BAT1.status == "Discharging" && EWW_BATTERY.BAT1.capacity <= 50 ? "battery-level-50-symbolic" : 
                       EWW_BATTERY.BAT1.status == "Discharging" && EWW_BATTERY.BAT1.capacity <= 60 ? "battery-level-60-symbolic" : 
                       EWW_BATTERY.BAT1.status == "Discharging" && EWW_BATTERY.BAT1.capacity <= 70 ? "battery-level-70-symbolic" : 
                       EWW_BATTERY.BAT1.status == "Discharging" && EWW_BATTERY.BAT1.capacity <= 80 ? "battery-level-80-symbolic" : 
                       EWW_BATTERY.BAT1.status == "Discharging" && EWW_BATTERY.BAT1.capacity <= 90 ? "battery-level-90-symbolic" : 
                       EWW_BATTERY.BAT1.status == "Discharging" && EWW_BATTERY.BAT1.capacity <= 100 ? "battery-level-100-symbolic" : 
                       "battery-missing-symbolic"
                       })
         (label :tooltip "${EWW_BATTERY.BAT1.status}"
                :text "${EWW_BATTERY.BAT1.capacity}%"
         )
    )
)

; Disk
(defwidget disk_short []
    (label :class "disk-short"
           :text "${round(EWW_DISK['/'].used_perc, 2)}%"
    )
)

; Network
(defwidget NET_short []
    (box :class "net-short"
         :halign "center"
         :space-evenly false
         :spacing 10
         (label :text "↑${round(EWW_NET.wlan0.NET_UP, 2)}")
         "|"
         (label :text "↓${round(EWW_NET.wlan0.NET_DOWN, 2)}")
    )
)

; == == == Power == == ==
(defvar sys_reveal false)

(defwidget power_off []
    (eventbox :class "power-off"
              :tooltip "Powers of system with `systemctl poweroff` there is no delay"
              :onclick "systemctl poweroff"
              :cursor "pointer"
              (image :icon "system-shutdown-symbolic")
    )
)

(defwidget suspend []
    (eventbox :class "suspend"
              :tooltip "Suspends the sustem with `systemctl suspend` there is no delay"
              :onclick "systemctl suspend"
              :cursor "pointer"
              (image :icon "system-log-out-symbolic")
    )
)

(defwidget reboot []
    (eventbox :class "reboot"
              :tooltip "Reboots the system with `systemctl reboot` there is no delay"
              :onclick "systemctl reboot"
              :cursor "pointer"
              (image :icon "system-reboot-symbolic")
    )
)

(defwidget lock []
    (eventbox :class "lock"
              :tooltip "Locks the system with `hyprlock` WARNING, CURRENTLY BROKEN"
              :onclick "hyprlock"
              :cursor "pointer"
              (image :icon "system-lock-screen-symbolic")
    )
)

(defwidget system_short []
    (eventbox :onhover "${EWW_CMD} update sys_reveal=true"
              :onhoverlost "${EWW_CMD} update sys_reveal=false"
              (box :class "system-short"
                   :orientation "horizontal"
                   :space-evenly false
                   :spacing 10
                   :hexpand true
                   (revealer :transition "slideleft"
                             :reveal sys_reveal
                             (box :orientation "horizontal"
                                  :space-evenly false
                                  :spacing 10
                                  (reboot)
                                  (power_off)
                                  (lock)
                                  (suspend)
                             )
                   )
                   (eventbox :cursor "pointer"
                             (image :icon "open-menu-symbolic")
                   )
              )
    )
)


; == == == Media == == ==
(defvar mute false)
(defvar vol_reveal false)
(defvar brt_reveal false)

(defwidget media_control_short []
    (box :class "music-control-short"
         :space-evenly false
         :spacing 1
         (label :text "${music_title}"
                :limit-width 25)
                (eventbox :class "media-prev"
                          :onclick "playerctl previous"
                          :tooltip "Previous track"
                          :cursor "pointer"
                          (image :icon "go-previous-symbolic")
                )
                (eventbox :class "media-play"
                          :onclick "playerctl play-pause"
                          :tooltip {music_status == "PLAYING" ? "Pause" : "Play"}
                          :cursor "pointer"
                          (image :icon {music_status == "PLAYING" ? "media-playback-pause-symbolic" : "media-playback-start-symbolic"})
                )
                (eventbox :class "media-next"
                          :onclick "playerctl next"
                          :tooltip "Next track"
                          :cursor "pointer"
                          (image :icon "go-next-symbolic")
                )
    )
)

(defwidget bluetooth_icon []
    (image :class "bluetooth-icon"
           :icon "bluetooth-symbolic"
    )
)

(defwidget volume_bar []
    (eventbox :onhover "${EWW_CMD} update vol_reveal=true"
              :onhoverlost "${EWW_CMD} update vol_reveal=false"
              (box :class "volume"
                   :orientation "horizontal"
                   :space-evenly false
                   :spacing 10
                   :hexpand true
                   (revealer :transition "slideleft"
                             :reveal vol_reveal
                             (scale :class "volume-bar"
                                    :value {vol_perc*100}
                                    :round-digits 0
                                    :tooltip "Volume: ${vol_perc*100}%"
                                    :orientation "horizontal"
                                    :max 100
                                    :min 0
                                    :onchange "wpctl set-volume @DEFAULT_AUDIO_SINK@ {}%"
                             )
                   )
                   (eventbox :class "volume-mute"
                             :onclick "${EWW_CMD} update mute=${!mute} && wpctl set-mute @DEFAULT_AUDIO_SINK@ ${!mute ? '1' : '0'}"
                             :cursor "pointer"
                             :tooltip {mute ? "Unmute" : "Mute"}
                             (image :icon {mute ? "audio-volume-muted-symbolic" : "audio-volume-high-symbolic"})
                   )
              )
    )
)

(defwidget brightness_bar []
    (eventbox :onhover "${EWW_CMD} update brt_reveal=true"
              :onhoverlost "${EWW_CMD} update brt_reveal=false"
              (box :class "brightness"
                   :orientation "horizontal"
                   :space-evenly false
                   :spacing 10
                   :hexpand true
                   (revealer :transition "slideleft"
                             :reveal brt_reveal
                             (scale :class "brightness-bar"
                                    :value {brt_perc}
                                    :round-digits 0
                                    :tooltip "Brightness: ${round(brt_perc/255*100, 0)}%"
                                    :orientation "horizontal"
                                    :max 255
                                    :min 5
                                    :onchange "brightnessctl set {}"
                             )
                   )
                   (image :icon "display-brightness-symbolic")
              )
    )
)


; == == == Hyprland == == ==
(defwidget workspaces []
    (box :class "workspaces"
         :spacing 5
         (for workspace in workspaces
            (eventbox :onclick "hyprctl dispatch workspace ${workspace.id}"
                      :cursor "pointer"
                      :class "workspace-entry ${workspace.id == current_workspace ? "current-workspace" : ""} ${workspace.windows > 0 ? "occupied-workspace" : "empty-workspace"}"
            )
         )
    )
)
