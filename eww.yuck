; == == == This file creates all the EWW-windows == == ==

(include "./widgets.yuck")

(defwidget left []
    (box :orientation "horizontal"
         :space-evenly false
         :spacing 15
         (NET_short)
         (CPU_short)
         (RAM_short)
         (battery)
    )
)

(defwidget middle []
    (box :orientation "horizontal"
         :space-evenly false
         :spacing 15
         :halign "center"
         (time)
    )
)

(defwidget right []
    (box :orientation "horizontal"
         :space-evenly false
         :spacing 15
         :halign "end"
         (media_control_short)
         (bluetooth_icon)
         (volume_bar)
         (brightness_bar)
         (system_short)
    )
)

(defwidget bar []
    (centerbox :orientation "horizontal"
               :class "bar"
               (left)
               (middle)
               (right)
    )
)

(defwindow bar
    :monitor 0
    :geometry (geometry :x "0%"
                        :y "1%"
                        :width "98.5%"
                        :height "2.5%"
                        :anchor "top center")
    :stacking "fg"
    :exclusive true
    (bar)
)
