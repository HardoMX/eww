; == == == This file creates all the EWW-windows == == ==

(include "./widgets.yuck")

; == == == Top bar == == ==
(defwidget left []
    (box :orientation "horizontal"
         :space-evenly false
         :spacing 15
         (NET_short)
         (CPU_short)
         (RAM_short)
         (battery)
    )
)

(defwidget middle []
    (eventbox :orientation "horizontal"
              :space-evenly false
              :spacing 15
              :halign "center"
              :onclick "${EWW_CMD} update date_reveal=${!date_reveal}"
              :cursor "pointer"
              (time)
    )
)

(defwidget right []
    (box :orientation "horizontal"
         :space-evenly false
         :spacing 15
         :halign "end"
         (media_control_short)
         (system_tray)
         (volume_bar)
         (brightness_bar)
         (system_short)
    )
)

(defwidget bar []
    (centerbox :orientation "horizontal"
               :class "bar"
               (left)
               (middle)
               (right)
    )
)

(defwindow bar
    :monitor 0
    :geometry (geometry :x "0%"
                        :y "1%"
                        :width "98.5%"
                        :height "2.5%"
                        :anchor "top center")
    :stacking "fg"
    :exclusive true
    (bar)
)

; == == == Bar expanding == == ==
(defvar date_reveal false)

(defwidget date_full [reveal]
    (revealer :transition "slidedown"
              :reveal reveal
              (box :orientation "vertical"
                   :space-evenly false
                   :spacing 5
                   (box :orientation "horizontal"
                        :space-evenly false
                        :spacing 5
                        (calendar :show-week-numbers true
                                  :day 10
                                  :class "calendar")
                        (box :orientation "vertical"
                             :space-evenly false
                             :spacing -45
                             :valign "center"
                             :class "clock-vert"
                             (hour)
                             (minute)
                        )
                   )
                   (weather_long)
              )
    )
)

(defwindow date_full
    :monitor 0
    :geometry (geometry :x "0%"
                        :y "3%"
                        :width "0%"
                        :height "0%"
                        :anchor "top center")
    :stacking "fg"
    :exclusive false
    (date_full :reveal date_reveal)
)

; == == == Bottom bar/Workspaces == == ==
(defwindow workspaces
    :monitor 0
    :geometry (geometry :x "0%"
                        :y "0%"
                        :width "100%"
                        :height "0.75%"
                        :anchor "bottom center")
    :stacking "fg"
    :exclusive false
    (workspaces)
)
