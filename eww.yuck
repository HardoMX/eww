; == == == This file creates all the EWW-windows == == ==

(include "./widgets.yuck")

(defwidget middle []
    (box :orientation "horizontal"
         (time)
         (lock)
         (battery)
    )
)

(defwindow bar
    :monitor 0
    :geometry (geometry :x "0%"
                        :y "0%"
                        :width "95%"
                        :height "2"
                        :anchor "top center")
    :stacking "fg"
    :exclusive true
    (middle)
)
